<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale_team_under_customer" model="ir.ui.view">
        <field name="name">sale.order.form.sale.team.under.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='team_id']" position="replace"/>
            <field name="partner_id" position="attributes">
                <attribute name="readonly">state == 'cancel'</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="stock_requester_id"
                       domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       readonly="state != 'draft'"/>
                <field name="stock_issuer_id"
                       domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       readonly="state != 'draft'"/>
                <field name="team_id"
                       context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"
                       options="{'no_create': True}" readonly="state != 'draft'"/>
                <field name="analytic_account_id"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       readonly="state != 'draft'"/>
            </field>

            <field name="order_line" position="attributes">
                <attribute name="readonly">state in ['sale', 'cancel'] or locked</attribute>
            </field>

            <field name="order_line" position="before">
                <field name="available_sale_product_ids" invisible="1"/>
                <field name="available_sale_template_ids" invisible="1"/>
            </field>

            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="domain">['|', ('is_storable', '=', False), ('id', 'in', parent.available_sale_product_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">['|', ('is_storable', '=', False), ('id', 'in', parent.available_sale_template_ids)]</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="pricelist_override_id" column_invisible="1"/>
                <field name="pricelist_type_id" string="Pricelist Type"
                       domain="[('currency_id', '=', parent.currency_id)]"
                       groups="sale_team_warehouse.group_allow_pricelist_type"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="qty_invoiced != 0" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="pricelist_override_id" invisible="1"/>
                <field name="pricelist_type_id" string="Pricelist Type"
                       domain="[('currency_id', '=', parent.currency_id)]"
                       groups="sale_team_warehouse.group_allow_pricelist_type"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="qty_invoiced != 0"/>
            </xpath>

            <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
