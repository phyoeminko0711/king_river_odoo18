<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale_team_under_customer" model="ir.ui.view">
        <field name="name">sale.order.form.sale.team.under.customer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='team_id']" position="replace"/>
            <field name="partner_id" position="after">
                <field name="team_id"
                       context="{'kanban_view_ref': 'sales_team.crm_team_view_kanban'}"
                       options="{'no_create': True}" readonly="state != 'draft'"/>
                <field name="analytic_account_id"
                       options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                       readonly="state != 'draft'"/>
            </field>

            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
