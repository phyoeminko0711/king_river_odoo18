<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_line_product_internal_view" model="ir.ui.view">
        <field name="name">purchase.order.form.line.product.internal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="car_name" readonly="1" optional="show"/>
                <field name="lh_rh" readonly="1" optional="show"/>
                <field name="model_engine" readonly="1" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="car_name" readonly="1"/>
                <field name="lh_rh" readonly="1"/>
                <field name="model_engine" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
        </field>
    </record>

