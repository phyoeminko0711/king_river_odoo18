<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="login_layout_hide_powered_by_and_manage_db" inherit_id="web.login_layout" name="Login Layout">
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="before">
            <t t-set="disable_database_manager" t-value="1"/>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span>Powered by GRO</span>
        </xpath>
    </template>
</odoo>