<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_rate_scheme_list" model="ir.ui.view">
        <field name="name">product.rate.scheme.list</field>
        <field name="model">product.rate.scheme</field>
        <field name="arch" type="xml">
            <list string="Rate Schemes">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_product_rate_scheme_form" model="ir.ui.view">
        <field name="name">product.rate.scheme.form</field>
        <field name="model">product.rate.scheme</field>
        <field name="arch" type="xml">
            <form string="Rate Scheme">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_rate_scheme" model="ir.actions.act_window">
        <field name="name">Rate Schemes</field>
        <field name="res_model">product.rate.scheme</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_rate_scheme"
              name="Rate Schemes"
              parent="stock.menu_product_in_config_stock"
              action="action_product_rate_scheme"
              groups="stock.group_stock_manager"
              sequence="30"/>
</odoo>
