<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_inspection_template_list" model="ir.ui.view">
        <field name="name">workshop.inspection.template.list</field>
        <field name="model">workshop.inspection.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_workshop_inspection_template_form" model="ir.ui.view">
        <field name="name">workshop.inspection.template.form</field>
        <field name="model">workshop.inspection.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="inspection_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description" string="Checkpoint"/>
                                    <field name="result_type_id"/>
                                    <field name="default_result_option_id"
                                           domain="[('result_type_id', '=', result_type_id), ('active', '=', True)]"/>
                                    <field name="required"/>
                                    <field name="photo_required"/>
                                    <field name="allow_multiple_photos"/>
                                    <field name="active"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="description" string="Checkpoint"/>
                                        <field name="result_type_id"/>
                                        <field name="default_result_option_id"
                                               domain="[('result_type_id', '=', result_type_id), ('active', '=', True)]"/>
                                        <field name="required"/>
                                        <field name="photo_required"/>
                                        <field name="allow_multiple_photos"/>
                                        <field name="active"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workshop_inspection_template_search" model="ir.ui.view">
        <field name="name">workshop.inspection.template.search</field>
        <field name="model">workshop.inspection.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="inspection_type"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Inspection Type" context="{'group_by': 'inspection_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_workshop_inspection_template" model="ir.actions.act_window">
        <field name="name">Inspection Templates</field>
        <field name="res_model">workshop.inspection.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workshop_inspection_template_search"/>
    </record>
</odoo>
