<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_workshop_service_flags" model="ir.ui.view">
        <field name="name">product.template.form.workshop.service.flags</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="is_workshop_service" invisible="type != 'service'"/>
                <field name="is_labour_cost" invisible="type != 'service'"/>
            </field>
        </field>
    </record>
</odoo>
