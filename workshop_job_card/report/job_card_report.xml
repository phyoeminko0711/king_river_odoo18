<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_workshop_job_card" model="report.paperformat">
        <field name="name">King River Job Card A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_workshop_job_card" model="ir.actions.report">
        <field name="name">Job Card Report</field>
        <field name="model">workshop.job.card</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">workshop_job_card.report_workshop_job_card_document</field>
        <field name="report_file">workshop_job_card.report_workshop_job_card_document</field>
        <field name="print_report_name">'Job_Card_%s' % (object.name or object.id)</field>
        <field name="binding_model_id" ref="model_workshop_job_card"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="workshop_job_card.paperformat_workshop_job_card"/>
    </record>

    <template id="report_workshop_job_card_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id or res_company"/>
                <t t-set="currency" t-value="doc.currency_id or company.currency_id"/>
                <t t-set="matrix" t-value="doc._get_brand_quote_matrix()"/>
                <t t-set="report_filename" t-value="('Job_Card_%s' % (doc.name or doc.id)).replace('/', '_').replace(' ', '_')"/>
                <div class="page kr-job-card">
                    <script type="text/javascript">
                        document.title = "<t t-out="report_filename"/>";
                    </script>
                    <style>
                        @page {
                            size: A4;
                            margin: 0;
                        }
                        @media print {
                            html,
                            body {
                                margin: 0 !important;
                                padding: 0 !important;
                            }
                            .kr-job-card {
                                padding: 8mm 7mm !important;
                                box-sizing: border-box;
                            }
                        }
                        .kr-job-card {
                            font-family: 'Noto Sans Myanmar', 'Pyidaungsu', 'Myanmar Text', Arial, sans-serif;
                            font-size: 11px;
                            color: #000;
                        }
                        .kr-header { table-layout: fixed; }
                        .kr-header td { vertical-align: middle; }
                        .kr-header-logo { width: 18%; text-align: left; }
                        .kr-header-main { width: 57%; text-align: center; }
                        .kr-header-contact { width: 25%; text-align: right; font-weight: 700; font-size: 11px; }
                        .kr-center { text-align: center; }
                        .kr-logo { max-height: 65px; max-width: 120px; }
                        .kr-company-name { font-size: 20px; font-weight: 700; overflow-wrap: anywhere; }
                        .kr-company-subtitle { font-size: 12px; font-weight: 600; }
                        .kr-company-line { font-size: 10px; line-height: 1.35; }
                        .kr-divider { border-top: 2px solid #000; margin: 7px 0 8px; }
                        .kr-title { font-size: 15px; font-weight: 700; text-align: center; margin: 5px 0 8px; }
                        table { width: 100%; border-collapse: collapse; }
                        .kr-detail-section { margin: 12px 0; page-break-inside: avoid; }
                        .kr-detail-heading {
                            font-size: 11px;
                            font-weight: 700;
                            border-bottom: 1px solid #000;
                            padding-bottom: 3px;
                            margin-bottom: 7px;
                        }
                        .kr-detail-columns { font-size: 0; }
                        .kr-detail-column {
                            display: inline-block;
                            width: 50%;
                            vertical-align: top;
                            box-sizing: border-box;
                            padding-right: 12px;
                            font-size: 11px;
                        }
                        .kr-detail-item { margin-bottom: 6px; }
                        .kr-detail-label {
                            display: inline-block;
                            width: 42%;
                            vertical-align: top;
                            font-weight: 600;
                        }
                        .kr-detail-value {
                            display: inline-block;
                            width: 58%;
                            vertical-align: top;
                            overflow-wrap: anywhere;
                        }
                        .kr-lines { margin-top: 10px; page-break-inside: auto; table-layout: fixed; font-size: 9px; }
                        .kr-lines th {
                            border: 1px solid #000;
                            padding: 4px 2px;
                            font-weight: 700;
                            text-align: center;
                            overflow-wrap: anywhere;
                        }
                        .kr-lines td {
                            border: 1px solid #000;
                            padding: 4px 2px;
                            vertical-align: top;
                            overflow-wrap: anywhere;
                        }
                        .kr-lines thead { display: table-header-group; }
                        .kr-lines tr { page-break-inside: avoid; }
                        .kr-lines .kr-description { width: 26%; }
                        .kr-lines .kr-qty { width: 5%; }
                        .kr-lines .kr-uom { width: 7%; }
                        .kr-lines .kr-made-in { width: 10%; }
                        .kr-right { text-align: right; }
                        .kr-center-cell { text-align: center; }
                        .kr-nowrap { white-space: nowrap; }
                        .kr-product-main { font-weight: 600; }
                        .kr-product-sub { font-size: 10px; margin-top: 2px; }
                        .kr-grand-total td {
                            font-size: 9px;
                            font-weight: 700;
                            border-top: 2px solid #000;
                        }
                        .kr-text-section {
                            margin-top: 8px;
                            border: 1px solid #000;
                            padding: 6px;
                            page-break-inside: avoid;
                        }
                        .kr-text-title { font-weight: 700; margin-bottom: 3px; }
                        .kr-inspection { margin-top: 6px; font-size: 10px; }
                        .kr-signatures {
                            margin-top: 18px;
                            page-break-inside: avoid;
                        }
                        .kr-signatures td {
                            width: 33.33%;
                            text-align: center;
                            padding-top: 30px;
                        }
                        .kr-sign-line {
                            border-top: 1px solid #000;
                            padding-top: 5px;
                            margin: 0 12px;
                            font-weight: 700;
                        }
                    </style>

                    <t t-set="company_mobile" t-value="company.mobile if 'mobile' in company._fields else False"/>
                    <table class="kr-header">
                        <tr>
                            <td class="kr-header-logo">
                                <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="kr-logo"/>
                            </td>
                            <td class="kr-header-main">
                                <div class="kr-company-name"><span t-field="company.name"/></div>
                                <div class="kr-company-subtitle" t-if="'report_header' in company._fields and company.report_header">
                                    <span t-field="company.report_header"/>
                                </div>
                                <div class="kr-company-line">
                                    <t t-if="company.street"><span t-field="company.street"/></t>
                                    <t t-if="company.street2">, <span t-field="company.street2"/></t>
                                    <t t-if="company.city">, <span t-field="company.city"/></t>
                                </div>
                            </td>
                            <td class="kr-header-contact">
                                <div t-if="company.phone"><span t-field="company.phone"/></div>
                                <div t-if="company_mobile"><span t-esc="company_mobile"/></div>
                            </td>
                        </tr>
                    </table>
                    <div class="kr-divider"/>
                    <div class="kr-title">JOB CARD / QUOTATION</div>

                    <section class="kr-detail-section">
                        <div class="kr-detail-heading">Job Card Information</div>
                        <div class="kr-detail-columns">
                            <div class="kr-detail-column">
                                <div class="kr-detail-item"><span class="kr-detail-label">Job Card No.</span><span class="kr-detail-value" t-field="doc.name"/></div>
                                <div class="kr-detail-item"><span class="kr-detail-label">Customer</span><span class="kr-detail-value" t-field="doc.customer_id"/></div>
                                <div class="kr-detail-item" t-if="doc.customer_phone"><span class="kr-detail-label">Phone</span><span class="kr-detail-value" t-field="doc.customer_phone"/></div>
                            </div>
                            <div class="kr-detail-column">
                                <div class="kr-detail-item"><span class="kr-detail-label">Job Card Date</span><span class="kr-detail-value" t-field="doc.job_card_date"/></div>
                            </div>
                        </div>
                    </section>

                    <t t-set="columns" t-value="matrix['columns']"/>
                    <t t-set="brand_cell_width" t-value="52.0 / (2 * len(columns))"/>
                    <table class="kr-lines">
                        <thead>
                            <tr>
                                <th class="kr-description">Part / Description</th>
                                <th class="kr-qty">Qty</th>
                                <th class="kr-uom">UoM</th>
                                <th class="kr-made-in">Made In</th>
                                <th t-foreach="columns" t-as="column" t-att-style="'width: ' + str(round(brand_cell_width, 3)) + '%'">
                                    <span t-esc="column['name']"/> Price
                                </th>
                                <th t-foreach="columns" t-as="column" t-att-style="'width: ' + str(round(brand_cell_width, 3)) + '%'">
                                    <span t-esc="column['name']"/> Amount
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="matrix['rows']" t-as="row">
                                <td>
                                    <div class="kr-product-main"><span t-esc="row['name']"/></div>
                                    <div class="kr-product-sub" t-if="row['secondary_name']">
                                        <span t-esc="row['secondary_name']"/>
                                    </div>
                                </td>
                                <td class="kr-center-cell"><span t-esc="'{:g}'.format(row['quantity'])"/></td>
                                <td class="kr-center-cell"><span t-esc="row['uom']"/></td>
                                <td class="kr-center-cell"><span t-esc="', '.join(row['brand_names'])"/></td>
                                <td t-foreach="columns" t-as="column" class="kr-right">
                                    <span t-if="column['id'] in row['prices']"
                                          t-esc="row['prices'][column['id']]"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                                <td t-foreach="columns" t-as="column" class="kr-right">
                                    <span t-if="column['id'] in row['amounts']"
                                          t-esc="row['amounts'][column['id']]"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                            <tr t-if="not matrix['rows']">
                                <td t-att-colspan="4 + 2 * len(columns)" class="kr-center-cell">No product lines.</td>
                            </tr>
                            <tr class="kr-grand-total" t-if="matrix['rows']">
                                <td t-att-colspan="4 + len(columns)" class="kr-right">TOTAL</td>
                                <td t-foreach="columns" t-as="column" class="kr-right">
                                    <span t-esc="matrix['totals'][column['id']]"
                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="kr-text-section" t-if="doc.complaint">
                        <div class="kr-text-title">Customer Complaint</div>
                        <span t-field="doc.complaint"/>
                    </div>
                    <div class="kr-text-section" t-if="doc.diagnosis">
                        <div class="kr-text-title">Diagnosis</div>
                        <span t-field="doc.diagnosis"/>
                    </div>
                    <div class="kr-text-section" t-if="doc.recommendation">
                        <div class="kr-text-title">Recommendation</div>
                        <span t-field="doc.recommendation"/>
                    </div>

                    <table class="kr-inspection" t-if="doc.customer_check_completed or doc.technician_inspection_completed">
                        <tr>
                            <td>
                                <strong>Customer Check:</strong>
                                <span t-if="doc.customer_check_completed">Completed</span>
                                <span t-else="">Pending</span>
                            </td>
                            <td>
                                <strong>Technician Inspection:</strong>
                                <span t-if="doc.technician_inspection_completed">Completed</span>
                                <span t-else="">Pending</span>
                            </td>
                        </tr>
                    </table>

                    <div class="kr-text-section">
                        <div class="kr-text-title">Remark / Notes</div>
                        <br/>
                    </div>

                    <table class="kr-signatures">
                        <tr>
                            <td><div class="kr-sign-line">Customer Signature</div></td>
                            <td><div class="kr-sign-line">Technician Signature</div></td>
                            <td><div class="kr-sign-line">Authorized Signature</div></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
