<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_workshop_inspection_check_wizard_form" model="ir.ui.view">
        <field name="name">workshop.inspection.check.wizard.form</field>
        <field name="model">workshop.inspection.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Inspection Check">
                <group>
                    <group>
                        <field name="job_card_id"/>
                        <field name="repair_order_id" invisible="not repair_order_id"/>
<!--                        <field name="inspection_type"/>-->
<!--                        <field name="template_id"/>-->
                    </group>
                    <group>
                        <field name="inspector_id"/>
                        <field name="inspection_date"/>
                    </group>
                </group>
                <separator string="Checkpoint"/>
                <field name="line_ids" invisible="1"/>
                <field name="current_line_id" invisible="1"/>
                <field name="total_checkpoint_count" invisible="1"/>
                <field name="current_checkpoint_number" invisible="1"/>
                <field name="all_checkpoints_answered" invisible="1"/>
                <field name="can_go_previous" invisible="1"/>
                <div class="text-center">
                    <field name="progress_text" readonly="1" nolabel="1" class="fw-bold"/>
                    <h2 invisible="not current_line_id">
                        <field name="current_checkpoint_name" readonly="1" nolabel="1"/>
                    </h2>
                    <field name="current_checkpoint_description"
                           readonly="1"
                           nolabel="1"
                           invisible="not current_checkpoint_description or not current_line_id"/>
                    <field name="current_remark"
                           placeholder="Enter remark..."
                           invisible="not current_line_id"/>
                </div>
                <footer>
                    <button name="action_previous_checkpoint"
                            type="object"
                            string="Previous"
                            class="btn-secondary"
                            invisible="not can_go_previous"/>
                    <button name="action_answer_yes"
                            type="object"
                            string="Yes"
                            icon="fa-check"
                            class="btn-success btn-lg"
                            invisible="not current_line_id"/>
                    <button name="action_answer_no"
                            type="object"
                            string="No"
                            icon="fa-times"
                            class="btn-danger btn-lg"
                            invisible="not current_line_id"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
