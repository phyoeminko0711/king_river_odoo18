<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sale_invoice_direct_print" model="ir.ui.view">
        <field name="name">account.move.form.sale.invoice.direct.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_print_pdf']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='preview_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_print_pdf'])[1]" position="after">
                <button name="action_print_sale_invoice_direct"
                        type="object"
                        string="Print"
                        class="oe_highlight"
                        data-hotkey="p"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>
