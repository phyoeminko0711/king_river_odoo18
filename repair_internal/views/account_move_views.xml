<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_repair_internal" model="ir.ui.view">
        <field name="name">account.move.form.repair.internal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_origin']" position="after">
                <field name="repair_order_id"
                       readonly="1"
                       invisible="not repair_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
