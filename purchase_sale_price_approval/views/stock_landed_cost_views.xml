<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_landed_cost_form_sale_price_updates" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.sale.price.updates</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_view_sale_price_updates"
                        class="oe_stat_button"
                        icon="fa-tags"
                        invisible="not sale_price_update_count">
                    <field name="sale_price_update_count"
                           widget="statinfo"
                           string="Sale Price Updates"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
