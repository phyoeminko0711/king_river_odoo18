<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_sale_price_revaluation_wizard_form" model="ir.ui.view">
        <field name="name">currency.sale.price.revaluation.wizard.form</field>
        <field name="model">currency.sale.price.revaluation.wizard</field>
        <field name="arch" type="xml">
            <form string="Currency Price Revaluation">
                <group>
                    <group>
                        <field name="revaluation_date"/>
                        <field name="currency_id"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="product_category_id"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_calculate_create_updates"
                            type="object"
                            string="Calculate / Create Price Updates"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_currency_sale_price_revaluation" model="ir.actions.act_window">
        <field name="name">Currency Price Revaluation</field>
        <field name="res_model">currency.sale.price.revaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_currency_sale_price_revaluation_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
